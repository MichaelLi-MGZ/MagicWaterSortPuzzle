    characterSetSelectionMode: 7
    characterSequence: "\u5065\u5EB7\u6E38\u620F\u5FE0\u544A\u62B5\u5236\u4E0D\u826F\u6E38\u620F\u62D2\u7EDD\u76D7\u7248\u6E38\u620F\u6CE8\u610F\u81EA\u6211\u4FDD\u62A4\u8C28\u9632\u53D7\u9A97\u4E0A\u5F53\u9002\u5EA6\u6E38\u620F\u76CA\u8111\u6C89\u8FF7\u6E38\u620F\u4F24\u8EAB\u5408\u7406\u5B89\u6392\u65F6\u95F4\u4EAB\u53D7\u5065\u5EB7\u751F\u6D3B\u91D1\u5E01\u4E0D\u8DB3\u79FB\u9664\u5E7F\u544A\u5305\u8D2D\u4E70\u5931\u8D25\uFF01\u7B2C\u5173\u9879\u76EE\u70B9\u51FB\u9501\u5B9A\u72B6\u6001\u5DF2\u65E0\u6CD5\u52A0\u8F7D\u6E38\u620F\u4E2D\u7684\u83B7\u6765\u89E3\u65B0\u7269\u54C1\u7528\u6237\u534F\u8BAE\u4E0E\u9690\u79C1\u4FDD\u62A4\u534F\u8BAE\u6B22\u8FCE\u60A8\u4F7F\u7528\u672C\u6E38\u620F\u5728\u4F7F\u7528\u672C\u6E38\u620F\u524D\u8BF7\u60A8\u5145\u5206\u9605\u8BFB\u5E76\u7406\u89E3\u4EE5\u4E0B\u5404\u6761\u6B3E\u9690\u79C1\u653F\u7B56\u4EE5\u53CA\u7528\u6237\u534F\u8BAE\u4E86\u89E3\u6211\u4EEC\u5BF9\u4E8E\u4E2A\u4EBA\u4FE1\u606F\u7684\u5904\u7406\u89C4\u5219\u548C\u6743\u9650\u7533\u8BF7\u7684\u76EE\u7684\u7279\u522B\u63D0\u9192\u60A8\u6CE8\u610F\u524D\u8FF0\u534F\u8BAE\u4E2D\u5173\u4E8E\u6211\u4EEC\u514D\u8D23\u81EA\u8EAB\u8D23\u4EFB\u9650\u5236\u60A8\u7684\u6743\u5229\u7684\u76F8\u5173\u6761\u6B3E\u53CA\u4E89\u8BAE\u89E3\u51B3\u65B9\u5F0F\u53F8\u6CD5\u7BA1\u8F96\u7B49\u5173\u7CFB\u4E3A\u786E\u4FDD\u60A8\u7684\u6E38\u620F\u4F53\u9A8C\u6211\u4EEC\u5C06\u5728\u60A8\u4F7F\u7528\u6211\u4EEC\u7684\u670D\u52A1\u8FC7\u7A0B\u4E2D\u7533\u8BF7\u90E8\u5206\u6743\u9650\u60A8\u53EF\u9009\u62E9\u540C\u610F\u6216\u8005\u4E0D\u540C\u610F\u4E0D\u540C\u610F\u5E76\u9000\u51FA\u540C\u610F\u5E76\u7EE7\u7EED\u6CE8\u610F\u60A8\u5982\u679C\u62D2\u7EDD\u672C\u6E38\u620F\u9690\u79C1\u653F\u7B56\u4EE5\u53CA\u7528\u6237\u534F\u8BAE\u4F1A\u65E0\u6CD5\u6B63\u5E38\u8FDB\u5165\u6E38\u620F\u8BF7\u786E\u8BA4\u662F\u5426\u9000\u51FA\u6E38\u620F\u9000\u51FA\u518D\u770B\u770B\u6279\u51C6\u6587\u53F7\u51FA\u7248\u7269\u53F7\u6E38\u620F\u8457\u4F5C\u6743\u4EBA\u51FA\u7248\u670D\u52A1\u5355\u4F4D\u9002\u9F84\u63D0\u793A\u8BF4\u660E\u5173\u95ED\u5192\u6CE1\u6D88\u606F\u63D0\u793A\u8BF4\u660E\u672C\u6E38\u620F\u662F\u4E00\u6B3E\u6B66\u4FA0\u7C7B\u89D2\u8272\u626E\u6F14\u6E38\u620F\u9002\u7528\u4E8E\u5E74\u6EE112\u5468\u5C81\u53CA\u4EE5\u4E0A\u7684\u7528\u6237\u5EFA\u8BAE\u672A\u6210\u5E74\u4EBA\u5728\u5BB6\u957F\u76D1\u62A4\u4E0B\u4F7F\u7528\u6E38\u620F\u4EA7\u54C1\u6211\u4EEC\u9F13\u52B1\u5BB6\u957F\u6839\u636E\u672A\u6210\u5E74\u4EBA\u7684\u5B9E\u9645\u60C5\u51B5\u7BA1\u7406\u5176\u6E38\u620F\u884C\u4E3A\uFF0C\u5BB6\u957F\u53EF\u4EE5\u8054\u7CFB\u5BA2\u670D\u4E86\u89E3\u5177\u4F53\u6307\u5F15\u672C\u6E38\u620F\u901A\u8FC7\u6E38\u620F\u754C\u9762\u7684\u4EA4\u4E92\u5BF9\u8BDD\u89D2\u8272\u6536\u96C6\u56DE\u5408\u5BF9\u6218\u7B49\u73A9\u6CD5\u63A8\u8FDB\u5267\u60C5\u6E38\u620F\u4E2D\u6709\u5C11\u91CF\u7684\u57FA\u4E8E\u6587\u5B57\u7684\u964C\u751F\u4EBA\u793E\u4EA4\u7CFB\u7EDF\u672C\u6E38\u620F\u4E2D\u6709\u7528\u6237\u5B9E\u540D\u8BA4\u8BC1\u7CFB\u7EDF\u8BA4\u8BC1\u4E3A\u672A\u6210\u5E74\u4EBA\u7684\u7528\u6237\u5C06\u63A5\u53D7\u4EE5\u4E0B\u7BA1\u7406\u672C\u6E38\u620F\u4EE5\u5267\u60C5\u4F53\u9A8C\u53CA\u6B66\u5B66\u4FEE\u70BC\u4E3A\u4E3B\u6E38\u620F\u4EE5\u6B66\u4FA0\u4E16\u754C\u4E3A\u80CC\u666F\u753B\u9762\u53E4\u6734\u5267\u60C5\u4E30\u6EE1\u53EF\u4EE5\u62D3\u5BBD\u73A9\u5BB6\u5BF9\u4E8E\u6B66\u4FA0\u6587\u5316\u7684\u4E86\u89E3\u5173\u95ED\u6E38\u620F\u5B9E\u540D\u8BA4\u8BC1\u4EB2\u7231\u7684\u65B0\u73A9\u5BB6\u670B\u53CB\u6839\u636E\u56FD\u5BB6\u65B0\u95FB\u51FA\u7248\u7F72\u5173\u4E8E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u5DE5\u4F5C\u7684\u901A\u77E5\u5173\u4E8E\u8FDB\u4E00\u6B65\u4E25\u683C\u7BA1\u7406
      \u5207\u5B9E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u7684\u901A\u77E5\u8981\u6C42\u6240\u6709\u7F51\u7EDC\u6E38\u620F\u7528\u6237\u5747\u9700\u4F7F\u7528\u6709\u6548\u8EAB\u4EFD\u8BC1\u4FE1\u606F\u65B9\u53EF\u8FDB\u884C\u6E38\u620F\u8D26\u53F7\u6CE8\u518C\u672A\u6210\u5E74\u4EBA\u5C06\u53D7\u5230\u9632\u6C89\u8FF7\u529F\u80FD\u9650\u5236\u4E3A\u5B8C\u6210\u5B9E\u540D\u8BA4\u8BC1\u6211\u4EEC\u9700\u6536\u96C6\u8EAB\u4EFD\u8BC1\u53F7\u548C\u59D3\u540D\u60A8\u8F93\u5165\u8EAB\u4EFD\u8BC1\u53F7\u548C\u59D3\u540D\u540E\u5373\u89C6\u4E3A\u60A8\u540C\u610F\u6211\u4EEC\u5C06\u5176\u7528\u4E8E\u9A8C\u8BC1\u8EAB\u4EFD\u5982\u62D2\u7EDD\u63D0\u4F9B\u6211\u4EEC\u5C06\u65E0\u6CD5\u4E3A\u60A8\u63D0\u4F9B\u6E38\u620F\u670D\u52A1\u59D3\u540D\u8EAB\u4EFD\u8BC1\u4FE1\u606F\u672A\u6210\u5E74\u4EBA\u6E38\u620F\u9650\u5236\u8BF4\u660E\u6839\u636E\u56FD\u5BB6\u65B0\u95FB\u51FA\u7248\u7F72\u53D1\u5E03\u7684\u5173\u4E8E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u5DE5\u4F5C\u7684\u901A\u77E5\u5173\u4E8E\u8FDB\u4E00\u6B65\u4E25\u683C\u7BA1\u7406\u5207\u5B9E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u7684\u901A\u77E5\u672A\u6EE118\u5C81\u7684\u672A\u6210\u5E74\u4EBA\u4EC5\u53EF\u5728\u5468\u4E94\u5468\u516D\u5468\u65E5\u548C\u6CD5\u5B9A\u8282\u5047\u65E5\u7684\u6BCF\u65E520\u65F6\u81F321\u65F6\u8FDB\u884C\u6E38\u620F\u5F53\u524D\u4E0D\u5728\u53EF\u6E38\u620F\u65F6\u95F4\u5185\u786E\u8BA4\u540E\u5C06\u9000\u51FA\u6E38\u620F\u5982\u679C\u7591\u95EE\u53EF\u8054\u7CFB\u5BA2\u670D\u54A8\u8BE2\u672A\u6210\u5E74\u4EBA\u4ED8\u8D39\u63D0\u793A\u60A8\u7684\u5B9E\u540D\u8BA4\u8BC1\u4FE1\u606F\u5C1A\u672A\u5E74\u6EE18\u5468\u5C81\u6839\u636E\u672A\u6210\u5E74\u4EBA\u9632\u6C89\u8FF7\u89C4\u5B9A\u672A\u6EE18\u5468\u5C81\u7684\u7528\u6237\u65E0\u6CD5\u8FDB\u884C\u5145\u503C\u64CD\u4F5C\u60A8\u7684\u5B9E\u540D\u8BA4\u8BC1\u4FE1\u606F\u5C1A\u672A\u5E74\u6EE116\u5468\u5C81\u6839\u636E\u672A\u6210\u5E74\u4EBA\u96